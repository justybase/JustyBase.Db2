<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Keep the consumer honest: the driver must not require runtime
         reflection when it is embedded in a NativeAOT application. -->
    <IsReflectionEnabledByDefault>false</IsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Db2.Driver/Db2.Driver.csproj" />
    <ProjectReference Include="../../src/Db2.IBMCompat/Db2.IBMCompat.csproj" />
  </ItemGroup>
</Project>
