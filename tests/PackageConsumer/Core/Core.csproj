<Project Sdk="Microsoft.NET.Sdk">
  <!-- Consumes the packed JustyBase.Db2 .nupkg only. Must never reference the driver source project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JustyBase.Db2" Version="$(ConsumerPackageVersion)" />
  </ItemGroup>
</Project>
